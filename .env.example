APP_NAME="SISTEMAS ESCOLARES"
TENANT_SLUG=
# Identificador del despliegue: rutas de logos, `php artisan se:switch`, y merge de `config/tenants/{slug}.php`.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_URL=http://localhost:8000
# Producción en subcarpeta (sin /public en la URL): URL pública completa, ej. https://dominio.com/ia/25demayo
# ASSET_URL=  # opcional; si se omite y APP_URL tiene path, se usa APP_URL para CSS/JS (@vite, asset())
# LIVEWIRE_ASSET_URL=  # opcional; si se omite y APP_URL tiene path, AppServiceProvider fija vendor/livewire/*.js
# SESSION_PATH se deriva del path de APP_URL en AppServiceProvider (cookies en subcarpeta)

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=false
SESSION_PATH=/
# En subcarpeta suele fijarse solo en AppServiceProvider desde APP_URL; si hace falta explícito: /ia/25demayo
SESSION_DOMAIN=null
# Producción HTTPS: true (requiere trustProxies si el hosting termina SSL delante de Apache)
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=escola_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correo: el Cuaderno de comunicados usa el mailer por defecto de Laravel.
# Valores reales solo en .env (nunca en el repositorio). Gmail: contraseña de aplicación de 16 caracteres (sin espacios).
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Cooperadora — recibos de ingreso (origen estudiantes). Cuenta distinta del cuaderno de comunicados (MAIL_*).
# Valores reales solo en .env del despliegue. Gmail: contraseña de aplicación de 16 caracteres.
COOP_MAIL_HOST=smtp.gmail.com
COOP_MAIL_PORT=587
COOP_MAIL_USERNAME=
COOP_MAIL_PASSWORD=
COOP_MAIL_ENCRYPTION=tls
COOP_MAIL_FROM_ADDRESS=
COOP_MAIL_FROM_NAME=
# true = registra envío simulado sin SMTP; false + COOP_MAIL_* = envío real (ver tenant.cooperadora.recibo_email.simulado).
COOP_RECIBO_EMAIL_SIMULADO=true

# Cuaderno de comunicados: tiempo máximo (segundos) de PHP durante el envío masivo en una sola petición (0 = no cambiar).
COM_DISTRIBUIR_MAX_SECONDS=300
# true con QUEUE_CONNECTION distinto de sync: lote de correos en cola (tabla jobs + php artisan queue:work).
COM_QUEUE_MAIL=false
# Mismo HTML para todos: un SMTP por lote con BCC (recomendado). false = un correo por destinatario.
COM_MAIL_AGRUPAR_BCC=true
# Cuántos destinatarios por mensaje BCC antes de fragmentar (límite del proveedor SMTP).
COM_MAIL_BCC_CHUNK=50

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WhatsApp manual (wa_link): web = WhatsApp Web en el navegador. El clic usa window.open (assets JS) para reutilizar la misma ventana; recompilar front: npm run build
#COM_WHATSAPP_MANUAL_LINK_STYLE=web
#COM_WHATSAPP_MANUAL_LINK_STYLE=wa_me
#COM_WHATSAPP_WA_LINK_TARGET=comunicaciones_whatsapp_wa

# Push (Guzzle → FCM): si aparece "cURL error 60" / SSL en Windows, ruta absoluta a cacert.pem
# https://curl.se/ca/cacert.pem  |  alternativa: curl.cainfo en php.ini
#WEB_PUSH_CA_BUNDLE=C:\php\extras\ssl\cacert.pem
#WEB_PUSH_HTTP_TIMEOUT=30
# Solo pruebas (inseguro): WEB_PUSH_SSL_VERIFY=false
