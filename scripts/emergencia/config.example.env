# Defaults impersonales por colegio.
# Copiar a scripts/emergencia/config.env (mismo contenido en todos los colegios).
# Personalización (AWS_BIN, HABILITAR_RESPALDO, tenant, MySQL emergencia) → .env Laravel.
# No commitear config.env (está en .gitignore).
# Mismas carpetas S3 que Silavet. El dump del colegio empieza con e (e1_slug_…).
# El del laboratorio empieza con l (l1_slug_…).

# Usuario/grupo del PHP (DirectAdmin: admin).
WEB_USER=admin
WEB_GROUP=admin

# Git (VPS de emergencia). Si producción se despliega desde sergio, cambialo acá.
GIT_URL=https://github.com/sergiorassino/sistema_ia.git
GIT_BRANCH=main

# DirectAdmin: PHP del panel, no el de AlmaLinux.
PHP_BIN=/usr/local/php83/bin/php

S3_BUCKET=sistesco
S3_PREFIX_DUMPS=backupDedicado/backupHora
S3_PREFIX_ARCHIVOS=backupDedicado/archivos

# Región del bucket. No dejes AWS_REGION= vacío (rompe el endpoint S3).
AWS_REGION=sa-east-1

# Restaurar desde el celular (public/emergencia-restaurar.php).
# Van en este archivo para que cada colegio las herede al copiar → config.env.
# Misma clave en todos los colegios de este sistema (distinta de la de Silavet).
# En el hosting de producción la página queda 404 (host y HABILITAR_RESPALDO=1).
# Para rotar: cambiá el token acá y en cada config.env.
HABILITAR_RESTAURAR_WEB=1
RESTAURAR_WEB_TOKEN=587fe56a13e2566acf8fc6aebefef9c65b7241466dded7e9deb8db2cd6b2872c
RESTAURAR_WEB_HOST=sistemasescolares4.com,sistemasescolares4.com.ar
